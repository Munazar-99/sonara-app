generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  standard
}

enum UserStatus {
  active
  pending
  suspended
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  REJECTED
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?

  name String

  role   UserRole   @default(standard)
  status UserStatus @default(pending)

  apiKey String

  billingRate Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastActive DateTime?

  calls      Call[]
  agents     Agent[]
  sessions   Session[]
  authTokens AuthToken[]

  monthlyUsage MonthlyUsage[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model EarlyAccess {
  id           String   @id
  email        String   @unique
  name         String
  createdAt    DateTime @default(now())
  businessName String
}

model AuthToken {
  id        String        @id @default(uuid())
  type      AuthTokenType
  userId    String
  email     String
  usedAt    DateTime?
  expiresAt DateTime
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@map("auth_tokens")
}

model Call {
  id String @id @default(cuid())

  retellCallId String @unique

  userId String

  startedAt DateTime
  endedAt   DateTime?

  agentId String?

  durationSeconds Int

  providerCost Decimal @db.Decimal(10, 3)
  customerCost Decimal @db.Decimal(10, 3)
  profit       Decimal @db.Decimal(10, 3)

  status String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, startedAt])
}

model MonthlyUsage {
  id String @id @default(cuid())

  userId String

  year  Int
  month Int

  totalCalls       Int @default(0)
  totalDurationSec Int @default(0)

  totalProviderCost Decimal @db.Decimal(10, 3)
  totalCustomerCost Decimal @db.Decimal(10, 3)
  totalProfit       Decimal @db.Decimal(10, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
}

model Agent {
  id String @id @default(cuid())

  retellAgentId String @unique

  name String?

  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model WebhookEvent {
  id String @id @default(cuid())

  provider String

  eventType String?

  externalEventId String?

  status WebhookEventStatus @default(PENDING)

  payload Json?

  rawBody String?

  signature String?

  headers Json?

  retryCount Int @default(0)

  responseStatus Int?

  lastError String?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
