generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  passwordHash          String?

  name                  String

  role                  UserRole   @default(standard)
  status                UserStatus @default(pending)

  apiKey                String

  billingRate           Float      @default(0.5)

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  lastActive            DateTime?

  /**
   * =========================================================
   * CURRENT MONTH (CACHE LAYER FOR FAST ADMIN USERS TABLE)
   * =========================================================
   */

  currentMonthCalls     Int     @default(0)
  currentMonthMinutes   Int     @default(0)
  currentMonthCost     Float   @default(0.0)

  /**
   * =========================================================
   * RELATIONS (SOURCE OF TRUTH + SYSTEM DATA)
   * =========================================================
   */

  calls                 Call[]
  usagePeriods          UsagePeriod[]
  Agents                Agent[]
  Sessions              Session[]
  authTokens            AuthToken[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}



model EarlyAccess {
  id           String   @id
  email        String   @unique
  name         String
  createdAt    DateTime @default(now())
  businessName String
}

enum UserRole {
  admin
  standard
}

enum UserStatus {
  active
  pending
  suspended
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(uuid())
  type      AuthTokenType
  userId    String
  email     String
  usedAt    DateTime?
  expiresAt DateTime
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

model Call {
  id                String   @id @default(cuid())

  retellCallId      String   @unique

  userId            String

  startedAt         DateTime
  endedAt           DateTime?
  agentId           String?

  durationSeconds   Int

  cost              Float

  status            String

  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id])

  @@index([userId, startedAt])
}

model UsagePeriod {
  id              String   @id @default(cuid())

  userId          String

  month           Int
  year            Int

  totalCalls      Int      @default(0)
  totalMinutes    Float    @default(0)
  totalCost       Float    @default(0)

  lastActiveAt    DateTime?

  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
}

model Agent {
  id              String   @id @default(cuid())

  retellAgentId   String   @unique

  name            String?

  userId          String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
}